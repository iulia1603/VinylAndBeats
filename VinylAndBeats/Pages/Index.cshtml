@page
@model IndexModel

<h1>Produse</h1>

<p>
    <a asp-page="/Products/Create" class="btn btn-primary">Adaugă produs</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nume</th>
            <th>Categorie</th>
            <th>Preț</th>
            <th>Stoc</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Price.ToString("0.00") lei</td>
                <td>@product.Stock</td>
                <td>
                    <a asp-page="/Products/Details" asp-route-id="@product.Id">Detalii</a>
                </td>
            </tr>
        }
    </tbody>
</table>