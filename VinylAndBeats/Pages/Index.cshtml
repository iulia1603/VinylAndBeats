@page
@model IndexModel

<h1>Produse</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nume</th>
            <th>Categorie</th>
            <th>Preț</th>
            <th>Stoc</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Price.ToString("0.00") lei</td>
                <td>@product.Stock</td>
            </tr>
        }
    </tbody>
</table>