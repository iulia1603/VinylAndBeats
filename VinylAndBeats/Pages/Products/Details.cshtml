@page "{id:int}"
@model DetailsModel

<h1>@Model.Product!.Name</h1>

<p><strong>Categorie:</strong> @Model.Product.Category?.Name</p>
<p><strong>Preț:</strong> @Model.Product.Price.ToString("0.00") lei</p>
<p><strong>Stoc:</strong> @Model.Product.Stock</p>
<p><strong>Descriere:</strong> @Model.Product.Description</p>

