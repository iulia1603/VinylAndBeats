@model ProductViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-8">
        <h1>@Model.Name</h1>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3" style="max-height: 400px; object-fit: cover;" />
        }
        <p class="text-muted">
            <strong>Categorie:</strong> @Model.CategoryName |
            <strong>Vânzător:</strong> @Model.SellerName |
            <strong>Stoc:</strong> @Model.Stock
        </p>
        <h4 class="text-primary">@Model.Price.ToString("0.00") lei</h4>
        <hr />
        <p>@Model.Description</p>
        @if (Model.Tags?.Any() == true)
        {
            <div class="mt-3">
                <strong>Etichete:</strong>
                @foreach (var tag in Model.Tags)
                {
                    <span class="badge bg-secondary">@tag</span>
                }
            </div>
        }
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                @{
                    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    var isAdmin = User.IsInRole("Admin");
                }
                @if (isAdmin || Model.SellerId == currentUserId)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning w-100 mb-2">Editare</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger w-100 mb-2">Ștergere</a>
                }
                @if (Model.SellerId != currentUserId && Model.Stock > 0)
                {
                    if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="mb-2">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <label class="form-label small">Cantitate</label>
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control mb-2" />
                            <button type="submit" class="btn btn-success w-100">Adaugă în coș</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-success w-100 mb-2">Adaugă în coș</a>
                    }
                }
                else if (Model.Stock == 0)
                {
                    <div class="alert alert-secondary py-2 text-center mb-2">Stoc epuizat</div>
                }
                <a asp-action="Index" class="btn btn-secondary w-100">Înapoi la produse</a>
            </div>
        </div>
    </div>
</div>