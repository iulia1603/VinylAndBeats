@model List<ProductViewModel>
@{
    ViewData["Title"] = "Produsele mele";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Produsele mele</h1>
    <a asp-action="Create" class="btn btn-primary">+ Adaugă produs</a>
</div>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">Nu ai pus niciun produs la vânzare încă.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@product.Name" />
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <p class="mb-1">@product.Price.ToString("0.00") lei</p>
                        @if (product.Stock == 0)
                        {
                            <span class="badge bg-danger">Stoc epuizat</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Stoc: @product.Stock</span>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Detalii</a>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Editează</a>
                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Șterge</a>
                    </div>
                </div>
            </div>
        }
    </div>
}