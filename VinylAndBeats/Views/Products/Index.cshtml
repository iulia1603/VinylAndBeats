@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Produse";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
}

<form asp-action="Index" method="get" class="mb-3">
    @if (Model.SelectedCategoryId.HasValue)
    {
        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
    }
    <div class="input-group">
        <input type="text" name="search" value="@Model.Search" class="form-control"
               placeholder="Caută după nume sau descriere..." />
        <button type="submit" class="btn btn-outline-secondary">Caută</button>
    </div>
</form>

<div class="mb-4">
    <a asp-action="Index" asp-route-search="@Model.Search"
       class="btn btn-sm @(Model.SelectedCategoryId == null ? "btn-dark" : "btn-outline-dark") me-2 mb-2">
        Toate produsele
    </a>
    @foreach (var cat in Model.Categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@Model.Search"
           class="btn btn-sm @(Model.SelectedCategoryId == cat.Id ? "btn-dark" : "btn-outline-dark") me-2 mb-2">
            @cat.Name
        </a>
    }
</div>

@if (Model.Products == null || !Model.Products.Any())
{
    <p class="text-muted">Niciun produs găsit.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light text-muted" style="height: 200px;">Fără imagine</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <p class="card-text">
                            @(product.Description.Length > 100 ? product.Description[..100] + "..." : product.Description)
                        </p>
                        <p class="fw-bold mb-0">@product.Price.ToString("0.00") lei</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted fst-italic">@product.CategoryName — vândut de @product.SellerName</small>
                        <div class="mt-2">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Detalii</a>
                            @if (isAdmin || product.SellerId == currentUserId)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Editare</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Ștergere</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}