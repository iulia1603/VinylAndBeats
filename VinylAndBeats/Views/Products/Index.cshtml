@model List<ProductViewModel>
@{
    ViewData["Title"] = "Produse";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Produse</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create" class="btn btn-primary">+ Vinde un produs</a>
    }
</div>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">Nu sunt produse.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <p class="card-text">
                            @(product.Description.Length > 100 ? product.Description[..100] + "..." : product.Description)
                        </p>
                        <p class="fw-bold mb-0">@product.Price.ToString("0.00") lei</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted fst-italic">@product.CategoryName — vândut de @product.SellerName</small>
                        <div class="mt-2">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Detalii</a>
                            @if (isAdmin || product.SellerId == currentUserId)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Editare</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Ștergere</a>
                            }
                            @if (User.Identity?.IsAuthenticated == true && product.SellerId != currentUserId)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">În coș</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}