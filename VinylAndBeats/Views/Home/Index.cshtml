@model HomeViewModel
@{
    ViewData["Title"] = "Acasă";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 text-center">
    <h1 class="display-5 fw-bold">VinylAndBeats</h1>
    <p class="lead">Bazarul tău de muzică — cumpără și vinde instrumente, viniluri, CD-uri și accesorii.</p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Cele mai noi anunțuri</h2>
    <a asp-controller="Products" asp-action="Index" class="text-decoration-none">Vezi toate →</a>
</div>

@if (!Model.RecentProducts.Any())
{
    <p class="text-muted">Nu sunt produse încă.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var product in Model.RecentProducts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" style="height: 160px; object-fit: cover;" alt="@product.Name" />
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <span class="badge bg-secondary mb-2">@product.CategoryName</span>
                        <p class="card-text small">
                            @(product.Description.Length > 70 ? product.Description[..70] + "..." : product.Description)
                        </p>
                        <p class="fw-bold mb-0">@product.Price.ToString("0.00") lei</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                           class="btn btn-sm btn-info w-100">Detalii</a>
                    </div>
                </div>
            </div>
        }
    </div>
}